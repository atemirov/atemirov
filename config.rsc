add address=192.36.143.130
/system scheduler
add disabled=yes interval=1m name=telegram-alerts on-event=\
    "/system/script/run send-telegram" policy=\
    ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon \
    start-date=2025-02-11 start-time=22:59:30
/system script
add dont-require-permissions=no name="\CE\E1\ED\EE\E2\EB\E5\ED\E8\E5 IP" \
    owner=atemirov policy=\
    ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon source=":\
    local hostnames {\"miro.com\";\"api.miro.com\";\"googlevideo.com\";\"youtu\
    be.com\";\"google.com\"}\r\
    \n:local listname \"VPN_new\"\r\
    \n:local ips\r\
    \n\r\
    \n/ip firewall address-list remove [find where list=\$listname]\r\
    \n\r\
    \n:foreach hostname in \$hostnames do={\r\
    \n    :do {:set ips [:resolve \$hostname]} on-error={:log debug (\"failed \
    to resolve \$hostname\")}\r\
    \n\r\
    \n    /ip firewall address-list add address=\$ips list=\$listname comment=\
    \$hostname\r\
    \n}"
/tool sniffer
set file-name=scan filter-ip-address=185.209.161.107/32 memory-limit=5000KiB
