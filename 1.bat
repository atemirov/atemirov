@echo off setlocal enabledelayedexpansion REM Настройки set LOG_FILE=C:\restic\backup.log set TEMP_LOG=C:\restic\temp_log.txt set BACKUP_SUCCESS=1 REM Очищаем временные файлы if exist "%TEMP_LOG%" del "%TEMP_LOG%" 2>nul REM Очищаем лог echo. > "%LOG_FILE%" REM Загружаем переменные if exist "C:\restic\env.bat" ( call C:\restic\env.bat echo Environment loaded >> "%LOG_FILE%" echo Repository: %RESTIC_REPOSITORY% >> "%LOG_FILE%" ) else ( echo ERROR: env.bat not found >> "%LOG_FILE%" set BACKUP_SUCCESS=0 goto :SEND_ALERT ) REM Заголовок лога echo ================================================== >> "%LOG_FILE%" echo Server: 192.168.137.3 - Buhgalteriya SQL BCP Backup >> "%LOG_FILE%" echo Date: %date% Time: %time% >> "%LOG_FILE%" echo Restic: C:\restic\restic.exe >> "%LOG_FILE%" echo Source: D:\sql_bcp >> "%LOG_FILE%" echo Repository: %RESTIC_REPOSITORY% >> "%LOG_FILE%" echo Rotation: Keep last 30 snapshots >> "%LOG_FILE%" echo ================================================== >> "%LOG_FILE%" REM Проверяем существование папки D:\sql_bcp if not exist "D:\sql_bcp" ( set BACKUP_SUCCESS=0 echo ERROR: D:\sql_bcp directory not found >> "%LOG_FILE%" goto :SEND_ALERT ) REM Бэкап D:\sql_bcp (ЕДИНСТВЕННАЯ операция с трафиком в S3) echo Starting D:\sql_bcp backup >> "%LOG_FILE%" echo Command: C:\restic\restic.exe backup D:\sql_bcp --tag=sql_bcp >> "%LOG_FILE%" C:\restic\restic.exe backup "D:\sql_bcp" --tag=sql_bcp --exclude="*.tmp" --exclude="*.lck" --exclude="*.log" --verbose > "%TEMP_LOG%" 2>&1 if not %ERRORLEVEL%==0 ( set BACKUP_SUCCESS=0 echo ERROR: SQL BCP backup failed. Code: %ERRORLEVEL% >> "%LOG_FILE%" type "%TEMP_LOG%" >> "%LOG_FILE%" del "%TEMP_LOG%" 2>nul goto :SEND_ALERT ) else ( echo SQL BCP backup completed successfully >> "%LOG_FILE%" type "%TEMP_LOG%" >> "%LOG_FILE%" del "%TEMP_LOG%" 2>nul ) REM Ротация: Оставляем только последние 30 снапшотов (0 трафика в S3) if %BACKUP_SUCCESS% EQU 1 ( echo Starting snapshot rotation (keeping last 30) >> "%LOG_FILE%" echo Command: C:\restic\restic.exe forget --keep-last 30 >> "%LOG_FILE%" C:\restic\restic.exe forget --keep-last 30 > "%TEMP_LOG%" 2>&1 if not %ERRORLEVEL%==0 ( echo WARNING: Rotation failed. Code: %ERRORLEVEL% >> "%LOG_FILE%" type "%TEMP_LOG%" >> "%LOG_FILE%" ) else ( echo Snapshot rotation completed (keeping last 30) >> "%LOG_FILE%" type "%TEMP_LOG%" >> "%LOG_FILE%" REM Точный подсчет снапшотов (только ID) C:\restic\restic.exe snapshots --json | find /c "id" > "%TEMP_LOG%" 2>&1 for /f %%i in ('type "%TEMP_LOG%"') do set "SNAPSHOT_COUNT=%%i" echo Current snapshots count: %SNAPSHOT_COUNT% >> "%LOG_FILE%" ) del "%TEMP_LOG%" 2>nul ) REM Локальная очистка кеша (0 трафика) echo Cleaning local restic cache >> "%LOG_FILE%" C:\restic\restic.exe cache --cleanup > "%TEMP_LOG%" 2>&1 if not %ERRORLEVEL%==0 ( echo WARNING: Cache cleanup failed. Code: %ERRORLEVEL% >> "%LOG_FILE%" ) else ( echo Local cache cleaned successfully >> "%LOG_FILE%" ) type "%TEMP_LOG%" >> "%LOG_FILE%" 2>nul del "%TEMP_LOG%" 2>nul :SEND_ALERT REM Формирование сообщения для Telegram if %BACKUP_SUCCESS% EQU 1 ( set "MESSAGE=Backup OK: SQL BCP Buhgalteriya (192.168.137.3) %date% %time%" if defined SNAPSHOT_COUNT set "MESSAGE=%MESSAGE% - Keeping %SNAPSHOT_COUNT% snapshots (30 days)" echo BACKUP COMPLETED SUCCESSFULLY >> "%LOG_FILE%" ) else ( set "MESSAGE=BACKUP ERROR: SQL BCP Buhgalteriya (192.168.137.3) %date% %time% - Check log: C:\restic\backup.log" echo BACKUP FAILED >> "%LOG_FILE%" ) REM Отправка в Telegram echo Sending Telegram notification to Thread 1425 >> "%LOG_FILE%" curl -s -d "chat_id=%TG_CHAT_ID%" -d "message_thread_id=1425" -d "text=%MESSAGE%" "https://api.telegram.org/bot%TG_TOKEN%/sendMessage" > "%TEMP_LOG%" 2>&1 if not %ERRORLEVEL%==0 ( echo ERROR: Failed to send notification >> "%LOG_FILE%" type "%TEMP_LOG%" >> "%LOG_FILE%" ) else ( echo Telegram notification sent successfully >> "%LOG_FILE%" ) if exist "%TEMP_LOG%" del "%TEMP_LOG%" 2>nul echo SQL BCP backup process completed >> "%LOG_FILE%" echo Log file: C:\restic\backup.log >> "%LOG_FILE%" echo Rotation policy: Keep last 30 snapshots >> "%LOG_FILE%" echo ================================================== >> "%LOG_FILE%" REM Автоматическое закрытие exit /b %BACKUP_SUCCESS%